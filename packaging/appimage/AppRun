#!/bin/bash
set -e

# Resolve APPDIR if not set by runtime
if [ -z "$APPDIR" ]; then
    APPDIR="$(dirname "$(readlink -f "$0")")"
fi

export APPDIR
export PATH="${APPDIR}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Clear foreign Python environment overrides (e.g. from Conda, Pyenv)
unset PYTHONHOME

# Determine Python interpreter:
# A GTK4/Adwaita desktop app requires the host OS distribution Python (e.g. /usr/bin/python3)
# where native system PyGObject, GTK4, and GStreamer bindings are installed.
# We explicitly avoid non-distro interpreters (such as Homebrew, Conda, Pyenv) that may
# prepend themselves to PATH with incompatible GLib/GObject runtimes.
PYTHON_BIN=""
for candidate in /usr/bin/python3 /bin/python3 $(command -v python3 2>/dev/null); do
    if [ -x "$candidate" ]; then
        if "$candidate" -c "import gi" 2>/dev/null; then
            PYTHON_BIN="$candidate"
            break
        fi
        if [ -z "$PYTHON_BIN" ]; then
            PYTHON_BIN="$candidate"
        fi
    fi
done

if [ -z "$PYTHON_BIN" ]; then
    echo "Error: No suitable python3 interpreter found on host system." >&2
    exit 1
fi

# Python environment: bundled packages in AppDir take highest precedence
PYTHONPATH="${APPDIR}/usr/lib/python3/dist-packages"
for py_dir in "${APPDIR}"/usr/lib/python3* /usr/lib/python3* /usr/local/lib/python3*; do
    if [ -d "${py_dir}/dist-packages" ] && [ "${py_dir}/dist-packages" != "${APPDIR}/usr/lib/python3/dist-packages" ]; then
        PYTHONPATH="${PYTHONPATH}:${py_dir}/dist-packages"
    fi
    if [ -d "${py_dir}/site-packages" ]; then
        PYTHONPATH="${PYTHONPATH}:${py_dir}/site-packages"
    fi
done
export PYTHONPATH

# GObject Introspection typelib search paths: bundled AppDir first, followed by system locations
for dir in \
    "${APPDIR}/usr/lib/x86_64-linux-gnu/girepository-1.0" \
    "${APPDIR}/usr/lib/girepository-1.0" \
    "${APPDIR}/usr/lib64/girepository-1.0" \
    /usr/lib/x86_64-linux-gnu/girepository-1.0 \
    /usr/lib/aarch64-linux-gnu/girepository-1.0 \
    /usr/lib64/girepository-1.0 \
    /usr/lib/girepository-1.0 \
    /usr/local/lib/girepository-1.0; do
    if [ -d "$dir" ]; then
        GI_TYPELIB_PATH="${GI_TYPELIB_PATH:+$GI_TYPELIB_PATH:}$dir"
    fi
done
export GI_TYPELIB_PATH

# GStreamer plugin search paths
for dir in \
    "${APPDIR}/usr/lib/x86_64-linux-gnu/gstreamer-1.0" \
    "${APPDIR}/usr/lib/gstreamer-1.0" \
    "${APPDIR}/usr/lib64/gstreamer-1.0" \
    /usr/lib/x86_64-linux-gnu/gstreamer-1.0 \
    /usr/lib/aarch64-linux-gnu/gstreamer-1.0 \
    /usr/lib64/gstreamer-1.0 \
    /usr/lib/gstreamer-1.0; do
    if [ -d "$dir" ]; then
        GST_PLUGIN_SYSTEM_PATH_1_0="${GST_PLUGIN_SYSTEM_PATH_1_0:+$GST_PLUGIN_SYSTEM_PATH_1_0:}$dir"
    fi
done
export GST_PLUGIN_SYSTEM_PATH_1_0

# Execute Video Cut
if [ -x "${APPDIR}/usr/bin/video-cut" ]; then
    exec "$PYTHON_BIN" "${APPDIR}/usr/bin/video-cut" "$@"
else
    exec "$PYTHON_BIN" -m video_cut "$@"
fi
